#!/usr/bin/env bash

set -Eeuo pipefail

TIMEOUT_SECONDS="${TRACKPAD_GUARD_TIMEOUT:-1.0}"

# Match constants for the xremap virtual keyboard (this machine's only
# observable keyboard node behind the kmonad→xremap grab chain; see README).
# The 1234:9950 IDs are this machine's xremap.service convention (its
# --vendor/--product flags), not a reserved xremap namespace.
# Edit all four together with install.sh, uninstall.sh and rules/*.rules.in
# if the remap stack changes — `make check` enforces they stay in sync.
KEYBOARD_NAME="xremap virtual keyboard"
KEYBOARD_VENDOR="1234"
KEYBOARD_PRODUCT="9950"
KEYBOARD_BUSTYPE="0003"

keyboard_event=""
grab_active=false
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="$runtime_dir/omarchy-trackpad-guard-${UID}.pid"
lock_file="$runtime_dir/omarchy-trackpad-guard-${UID}.lock"

log() {
  printf 'trackpad-guard: %s\n' "$*"
}

if [[ ! "$TIMEOUT_SECONDS" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || [[ "$TIMEOUT_SECONDS" =~ ^0*([.]0*)?$ ]]; then
  log "TRACKPAD_GUARD_TIMEOUT must be a positive number"
  exit 1
fi

# Fail fast on malformed match constants. The same values end up verbatim in
# the udev rule installed by install.sh, where *, ? and [...] act as match
# globs (a wildcard would turn the exact-match ACL into a pattern) and quotes
# or control characters would corrupt the rule syntax parsed by root-udevd;
# |, & and \ would additionally break the sed rendering of the rule template.
for hex_value in "$KEYBOARD_VENDOR" "$KEYBOARD_PRODUCT" "$KEYBOARD_BUSTYPE"; do
  if [[ ! "${hex_value,,}" =~ ^[0-9a-f]{4}$ ]]; then
    log "keyboard match IDs must be 4 hex digits, got: $hex_value"
    exit 1
  fi
done
forbidden_name_chars='[][:cntrl:]"\\|&*?[]'
if [[ -z "$KEYBOARD_NAME" || "$KEYBOARD_NAME" =~ $forbidden_name_chars ]]; then
  log "keyboard match name is empty or contains forbidden characters"
  exit 1
fi

for command_name in evtest flock hyprctl omarchy-hw-touchpad stdbuf; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    log "required command is missing: $command_name"
    exit 1
  fi
done

exec {lock_fd}>"$lock_file"
if ! flock -n "$lock_fd"; then
  log "another instance is already running"
  exit 0
fi
printf '%s\n' "$$" > "$pid_file"

discover_keyboard() {
  local event_path input_path name vendor product bustype

  keyboard_event=""
  for event_path in /sys/class/input/event*; do
    [[ -e "$event_path" ]] || continue
    input_path="$(readlink -f "$event_path/device")"
    # The event source IS xremap's uinput node, so it must live under
    # /sys/devices/virtual; a physical device spoofing these IDs is rejected.
    case "$input_path" in
      /sys/devices/virtual/*) ;;
      *) continue ;;
    esac
    [[ -r "$input_path/name" && -r "$input_path/id/vendor" && -r "$input_path/id/product" && -r "$input_path/id/bustype" ]] || continue

    name="$(<"$input_path/name")"
    vendor="$(<"$input_path/id/vendor")"
    product="$(<"$input_path/id/product")"
    bustype="$(<"$input_path/id/bustype")"

    if [[ "$name" == "$KEYBOARD_NAME" &&
          "${vendor,,}" == "${KEYBOARD_VENDOR,,}" &&
          "${product,,}" == "${KEYBOARD_PRODUCT,,}" &&
          "${bustype,,}" == "${KEYBOARD_BUSTYPE,,}" ]]; then
      keyboard_event="/dev/input/${event_path##*/}"
      break
    fi
  done

  [[ -c "$keyboard_event" && -r "$keyboard_event" ]]
}

trackpad_name="$(omarchy-hw-touchpad)"
if [[ -z "$trackpad_name" || "$trackpad_name" == *[[:cntrl:]]* ]]; then
  log "could not identify a safe Hyprland touchpad name"
  exit 1
fi

quoted_trackpad_name="${trackpad_name//\\/\\\\}"
quoted_trackpad_name="${quoted_trackpad_name//\"/\\\"}"

# The guard freezes the pointer by holding an exclusive evdev grab
# (EVIOCGRAB via `evtest --grab`) on the touchpad node while text keys are
# pressed — NOT by toggling hl.device(enabled=…). Each hl.device toggle
# re-initializes the I2C HID device in Hyprland; doing that per typing burst
# produced intermittent ghost contacts on the touchpad and stuck touch state
# in Hyprland (+1 finger on every gesture until `hyprctl reload`), the
# "dead trackpad" incident of 2026-09-04. An fd-bound grab costs nothing to
# acquire/release and vanishes when the fd closes, so it cannot corrupt
# device state.
ensure_trackpad_enabled() {
  # One-shot recovery from the pre-grab design: old versions toggled
  # hl.device(enabled=false) and a SIGKILL could leave the touchpad dead in
  # Hyprland. A single re-enable at startup/exit (no touch in flight) is
  # safe — unlike the per-burst toggles that caused the incident above.
  log "ensuring trackpad enabled=true in Hyprland (legacy-state recovery)"
  if ! hyprctl eval "hl.device({ name = \"$quoted_trackpad_name\", enabled = true })" >/dev/null 2>&1; then
    log "warning: failed to set trackpad enabled=true (hyprctl eval)"
    return 1
  fi
}

# Resolve the touchpad's /dev/input/eventNN node fresh before every grab:
# event numbers change across re-enumeration. Hyprland device names are the
# sysfs input name lowercased with spaces turned into dashes, which also
# disambiguates the twin "ASUF1208:00 2808:0218 Mouse" interface (its
# normalized name ends in -mouse, ours in -touchpad).
touchpad_event_node() {
  local event_path name normalized
  for event_path in /sys/class/input/event*; do
    [[ -e "$event_path" && -r "$event_path/device/name" ]] || continue
    name="$(<"$event_path/device/name")"
    normalized="${name,,}"
    normalized="${normalized// /-}"
    if [[ "$normalized" == "$trackpad_name" ]]; then
      printf '%s\n' "/dev/input/${event_path##*/}"
      return 0
    fi
  done
  return 1
}

grab_pid=""
grab_watchdog_pid=""

grab_touchpad() {
  local node
  if ! node="$(touchpad_event_node)"; then
    log "warning: touchpad event node not found; leaving pointer active"
    return 0
  fi
  if [[ ! -r "$node" ]]; then
    log "warning: $node is not readable (udev ACL missing?); leaving pointer active"
    return 0
  fi
  evtest --grab "$node" >/dev/null 2>&1 &
  grab_pid=$!
  # Watchdog: the grab fd lives in the evtest child, not in the guard, so an
  # orphaned child would freeze the touchpad indefinitely. If the guard dies
  # without running cleanup (SIGKILL on a manual launch), the watchdog kills
  # the grabber and the kernel releases the grab with the fd. $$ inside the
  # subshell still expands to the guard's PID (bash keeps $$ in subshells).
  # Under systemd this is a second net behind KillMode=control-group, which
  # reaps the whole cgroup when the unit stops or restarts.
  ( while kill -0 $$ 2>/dev/null; do sleep 0.3; done; kill "$grab_pid" 2>/dev/null ) &
  grab_watchdog_pid=$!
  log "grabbed $node (exclusive evdev grab while typing)"
}

release_touchpad() {
  [[ -n "$grab_pid" ]] || return 0
  kill "$grab_pid" 2>/dev/null || true
  wait "$grab_pid" 2>/dev/null || true
  grab_pid=""
  kill "$grab_watchdog_pid" 2>/dev/null || true
  wait "$grab_watchdog_pid" 2>/dev/null || true
  grab_watchdog_pid=""
  log "released touchpad grab"
}

# Defensive re-enable: versions before the grab design could leave the
# trackpad disabled in Hyprland, so every start (including systemd restarts)
# first recovers a known enabled state.
ensure_trackpad_enabled 2>/dev/null || true

cleanup() {
  trap - EXIT INT TERM HUP
  release_touchpad
  ensure_trackpad_enabled 2>/dev/null || true
  rm -f -- "$pid_file"
}

trap cleanup EXIT INT TERM HUP

# xremap is a hard dependency: without its virtual keyboard there is no
# observable keyboard node. The 30x1s discovery loop below tolerates xremap
# starts/restarts (xremap.service runs with Restart=always), so here we only
# warn.
command -v systemctl >/dev/null 2>&1 && ! systemctl is-active --quiet xremap && log "warning: xremap.service is not active; its virtual keyboard may not exist yet"

for _ in {1..30}; do
  if discover_keyboard; then
    break
  fi
  sleep 1
done

if [[ ! -c "$keyboard_event" || ! -r "$keyboard_event" ]]; then
  log "could not open the xremap virtual keyboard event device"
  log "is xremap.service active? See the xremap/kmonad section in README.md"
  exit 1
fi

log "monitoring ${keyboard_event} (${KEYBOARD_NAME}); grabbing ${trackpad_name} while typing; idle release is ${TIMEOUT_SECONDS}s"

declare -A held_modifiers=()

is_modifier() {
  case "$1" in
    KEY_LEFTCTRL|KEY_RIGHTCTRL|KEY_LEFTALT|KEY_RIGHTALT|KEY_LEFTSHIFT|KEY_RIGHTSHIFT|KEY_LEFTMETA|KEY_RIGHTMETA)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_navigation_key() {
  case "$1" in
    KEY_ESC|KEY_TAB|KEY_UP|KEY_DOWN|KEY_LEFT|KEY_RIGHT|KEY_HOME|KEY_END|KEY_PAGEUP|KEY_PAGEDOWN|KEY_INSERT|KEY_F[0-9]|KEY_F1[0-9]|KEY_F2[0-4])
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

coproc KEY_EVENTS { exec stdbuf -oL -eL evtest "$keyboard_event"; }
events_fd="${KEY_EVENTS[0]}"
evtest_pid="$KEY_EVENTS_PID"

while true; do
  line=""
  if $grab_active; then
    if ! IFS= read -r -t "$TIMEOUT_SECONDS" line <&"$events_fd"; then
      if kill -0 "$evtest_pid" 2>/dev/null; then
        release_touchpad
        grab_active=false
        continue
      fi
      break
    fi
  elif ! IFS= read -r line <&"$events_fd"; then
    break
  fi

  [[ "$line" == *"type 1 (EV_KEY)"* ]] || continue

  key_fragment="${line#*code }"
  key_fragment="${key_fragment#*\(}"
  key="${key_fragment%%\)*}"
  value="${line##*value }"

  [[ "$key" == KEY_* ]] || continue
  [[ "$value" == "0" || "$value" == "1" || "$value" == "2" ]] || continue

  if is_modifier "$key"; then
    if [[ "$value" == "0" ]]; then
      unset 'held_modifiers[$key]'
    else
      held_modifiers["$key"]=1
      if $grab_active; then
        release_touchpad
        grab_active=false
      fi
    fi
    continue
  fi

  [[ "$value" != "0" ]] || continue

  if (( ${#held_modifiers[@]} > 0 )) || is_navigation_key "$key"; then
    if $grab_active; then
      release_touchpad
      grab_active=false
    fi
  elif ! $grab_active; then
    grab_touchpad
    grab_active=true
  fi
done

log "keyboard event stream ended"
exit 1
