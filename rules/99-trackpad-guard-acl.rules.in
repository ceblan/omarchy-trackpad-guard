# Give only the installing desktop user read access to the two evdev nodes
# the guard needs. Match values are compile-time constants validated by
# `make check`; udev treats *, ? and [...] as match globs, so never
# introduce wildcards here — each ACL must stay an exact match.
#
# Rule 1: the xremap virtual keyboard. On this machine the physical
# keyboard (ITE 0b05:19b6) is grabbed by kmonad, whose output is in turn
# grabbed by xremap, so xremap's uinput node is the only
# userspace-observable keyboard. Unlike keyd's reserved 0fac:0ade
# namespace, the 1234:9950 IDs are NOT an xremap constant: they come from
# this machine's xremap.service flags (--vendor 0x1234 --product 0x9950),
# so they are a local convention — keep them in sync with that unit. The
# guard additionally requires the node to live under /sys/devices/virtual.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="xremap virtual keyboard", ATTRS{id/vendor}=="1234", ATTRS{id/product}=="9950", ATTRS{id/bustype}=="0003", RUN+="@SETFACL@ -m u:@USER@:r /dev/input/%k"
#
# Rule 2: the touchpad. The guard freezes the pointer with an exclusive
# evdev grab (EVIOCGRAB via `evtest --grab`) while text keys are pressed,
# which requires read access to the touchpad node. The grab replaced the
# old hl.device(enabled=…) toggles: each toggle re-initialized the I2C HID
# device and caused ghost contacts plus stuck Hyprland touch state (the
# 2026-09-04 "dead trackpad" incident). @TOUCHPAD_NAME@ is rendered from
# the sysfs input name by install.sh; ENV{ID_INPUT_TOUCHPAD}=="1" is a
# second anchor: the same I2C HID device also exposes a twin "...Mouse"
# interface, so the ACL must provably land on the touchpad interface only.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="@TOUCHPAD_NAME@", ENV{ID_INPUT_TOUCHPAD}=="1", RUN+="@SETFACL@ -m u:@USER@:r /dev/input/%k"
