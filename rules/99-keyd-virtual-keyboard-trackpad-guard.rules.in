# Give only the installing desktop user read access to the keyd virtual
# keyboard. On this machine the physical keyboard (ITE 0b05:19b6) is
# grabbed by kmonad, whose output is in turn grabbed by keyd, so keyd's
# uinput node is the only userspace-observable keyboard. The 0fac:0ade
# IDs are keyd's reserved uinput namespace; the guard additionally
# requires the node to live under /sys/devices/virtual. The abs==0 trick
# from the Apple version is gone: keyboard and touchpad are distinct
# devices here. Match values are compile-time constants validated by
# `make check`; udev treats *, ? and [...] as match globs, so never
# introduce wildcards here — the ACL must stay an exact match.
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="keyd virtual keyboard", ATTRS{id/vendor}=="0fac", ATTRS{id/product}=="0ade", ATTRS{id/bustype}=="0003", RUN+="@SETFACL@ -m u:@USER@:r /dev/input/%k"
